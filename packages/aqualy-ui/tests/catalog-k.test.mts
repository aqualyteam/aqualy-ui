import assert from 'node:assert/strict'
import test from 'node:test'
import { createElement as h } from 'react'
import { renderToStaticMarkup as render } from 'react-dom/server'
import { Tree } from '../src/components/tree'
import { Tooltip, TooltipTrigger, TooltipContent } from '../src/components/tooltip'
const nodes=[{id:'root',label:'Records',children:[{id:'leaf',label:'Agreement'},{id:'archived',label:'Archived',disabled:true,children:[{id:'hidden',label:'Old record'}]}]}]
test('Tree declares level, set position, selection and one roving tab stop',()=>{const html=render(h(Tree,{nodes,label:'Library',defaultExpandedIds:['root'],defaultSelectedId:'leaf'}));assert.match(html,/role="tree" aria-label="Library"/);assert.match(html,/aria-level="2"/);assert.match(html,/aria-posinset="1" aria-setsize="2"/);assert.equal((html.match(/tabindex="0"/g)??[]).length,1);assert.match(html,/aria-selected="true"[^>]*data-tree-id="leaf"/);assert.match(html,/aria-disabled="true"[^>]*data-tree-id="archived"/);assert.match(html,/aria-disabled="true"[^>]*data-tree-id="hidden"/);})
test('Tree filtering preserves paths and selection, without mutating caller expansion',()=>{const expanded=['root'];const html=render(h(Tree,{nodes,label:'Search',expandedIds:expanded,query:'Agreement',selectedId:'leaf'}));assert.match(html,/data-tree-id="root"/);assert.match(html,/data-tree-id="leaf"/);assert.doesNotMatch(html,/data-tree-id="archived"/);assert.deepEqual(expanded,['root']);const empty=render(h(Tree,{nodes,label:'Search',query:'missing',selectedId:'leaf'}));assert.match(empty,/No matching items/);assert.doesNotMatch(empty,/role="treeitem"/);})
test('Tree handles empty and disabled data, and rejects duplicate IDs',()=>{assert.match(render(h(Tree,{nodes:[],label:'Empty'})),/data-slot="empty/);assert.doesNotMatch(render(h(Tree,{nodes,label:'Disabled',disabled:true})),/tabindex="0"/);assert.throws(()=>render(h(Tree,{nodes:[{id:'same',label:'One'},{id:'same',label:'Two'}],label:'Invalid'})),/unique IDs/);})
test('Tooltip parts require a root and retain supplementary trigger name',()=>{assert.throws(()=>render(h(TooltipTrigger,{},'Help')),/require Tooltip/);const html=render(h(Tooltip,{children:[h(TooltipTrigger,{key:'trigger','aria-label':'Export manifest'},'Export'),h(TooltipContent,{key:'content'},'Short context')]}));assert.match(html,/aria-label="Export manifest"/);assert.doesNotMatch(html,/aria-describedby=/);})
