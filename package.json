{
  "name": "aqualy-ui-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "pnpm --filter @aqualy/ui build",
    "test": "pnpm build && node --import tsx --test packages/aqualy-ui/tests/*.test.mts && pnpm test:package && pnpm test:release",
    "test:package": "node --test tests/package/*.test.mjs",
    "typecheck": "pnpm --filter @aqualy/ui typecheck",
    "verify:public": "node scripts/verify-public-source.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:consumer": "node scripts/verify-c0-consumer.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "verify:candidate": "node scripts/verify-candidate.mjs",
    "test:release": "node --test tests/release/*.test.mjs"
  },
  "dependencies": {
    "@aqualy/ui": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "postcss-selector-parser": "7.1.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@base-ui/react": "1.5.0",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "libphonenumber-js": "1.13.2",
      "lucide-react": "1.16.0",
      "tailwind-merge": "3.6.0",
      "tw-animate-css": "1.4.0",
      "shadcn": "4.18.0"
    }
  }
}
